    "def clean_text_series(s):\n",
    "    return (\n",
    "        s.fillna(\"\")\n",
    "         .astype(str)\n",
    "         .str.replace(r\"\\r\", \" \", regex=True)\n",
    "         .str.replace(r\"\\n+\", \" \", regex=True)\n",
    "         .str.replace(r\"\\s+\", \" \", regex=True)\n",
    "         .str.strip()\n",
    "    )\n",
    "\n",
    "def basic_stats(df, name):\n",
    "    return {\n",
    "        \"dataset\": name,\n",
    "        \"samples\": len(df),\n",
    "        \"label_0_human\": int((df[\"label\"] == 0).sum()),\n",
    "        \"label_1_ai\": int((df[\"label\"] == 1).sum()),\n",
    "        \"avg_len_chars\": round(df[\"text\"].astype(str).str.len().mean(), 2),\n",
    "        \"max_len_chars\": int(df[\"text\"].astype(str).str.len().max()),\n",
    "        \"min_len_chars\": int(df[\"text\"].astype(str).str.len().min()),\n",
    "        \"avg_words\": round(df[\"text\"].astype(str).str.split().apply(len).mean(), 2),\n",
    "    }\n",
    "\n",
    "def load_daigt_external():\n",
    "    df = pd.read_csv(DATA_PATHS[\"daigt_external\"])\n",
    "    df = df.sample(frac=1, random_state=SEED).reset_index(drop=True)\n",
    "\n",
    "    # 原 notebook 逻辑：source_text vs text 成对构造\n",
    "    # 这里沿用，但统一定义：source_text = human(0), text = ai(1)\n",
    "    # 若你核对后发现某数据集正好相反，只需在这里改标签\n",
    "    train_part = df[:-200]\n",
    "    valid_part = df[-200:]\n",
    "\n",
    "    tr_h = pd.DataFrame({\"text\": clean_text_series(train_part[\"source_text\"]), \"label\": 0})\n",
    "    tr_ai = pd.DataFrame({\"text\": clean_text_series(train_part[\"text\"]), \"label\": 1})\n",
    "    va_h = pd.DataFrame({\"text\": clean_text_series(valid_part[\"source_text\"]), \"label\": 0})\n",
    "    va_ai = pd.DataFrame({\"text\": clean_text_series(valid_part[\"text\"]), \"label\": 1})\n",
    "\n",
    "    train_df = pd.concat([tr_h, tr_ai], axis=0).drop_duplicates().reset_index(drop=True)\n",
    "    valid_df = pd.concat([va_h, va_ai], axis=0).drop_duplicates().reset_index(drop=True)\n",
    "    return train_df, valid_df\n",
    "\n",
    "def load_llm7prompt():\n",
    "    df = pd.read_csv(DATA_PATHS[\"llm7prompt\"])\n",
    "    df[\"text\"] = clean_text_series(df[\"text\"])\n",
    "    # 原 notebook: label = 1 if x==0 else 0\n",
    "    # 说明原数据标签语义与本项目相反，这里保留它的转换逻辑\n",
    "    df[\"label\"] = df[\"label\"].apply(lambda x: 1 if x == 0 else 0)\n",
    "    return df[[\"text\", \"label\"]].drop_duplicates().reset_index(drop=True)\n",
    "\n",
    "def load_feedback_human():\n",
    "    f1 = pd.read_csv(DATA_PATHS[\"feedback_2021\"])\n",
    "    f2 = pd.read_csv(DATA_PATHS[\"feedback_effectiveness\"])\n",
    "\n",
    "    f1[\"text\"] = clean_text_series(f1[\"text\"])\n",
    "    f2[\"text\"] = clean_text_series(f2[\"text\"])\n",
    "\n",
    "    f1[\"chars_count\"] = f1[\"text\"].str.len()\n",
    "    f2[\"chars_count\"] = f2[\"text\"].str.len()\n",
    "\n",
    "    A = f1[(f1[\"chars_count\"] > 1000) & (f1[\"chars_count\"] < 1600)][[\"text\"]].copy()\n",
    "    B = f2[(f2[\"chars_count\"] > 1000) & (f2[\"chars_count\"] < 1600)][[\"text\"]].copy()\n",
    "\n",
    "    C = pd.concat([A, B], axis=0).reset_index(drop=True)\n",
    "    C[\"label\"] = 0   # human\n",
    "    return C[[\"text\", \"label\"]].drop_duplicates().reset_index(drop=True)\n",
    "\n",
    "def load_h2o():\n",
    "    df = pd.read_csv(DATA_PATHS[\"h2o\"])\n",
    "    df = df[~df[\"Response\"].isnull()].rename(columns={\"Response\": \"text\"})\n",
    "    df[\"text\"] = clean_text_series(df[\"text\"])\n",
    "    df[\"label\"] = 1  # 原 notebook 设为 1，这里沿用为 AI\n",
    "    return df[[\"text\", \"label\"]].drop_duplicates().reset_index(drop=True)\n",
    "\n",
    "def load_daigt_v2():\n",
    "    df = pd.read_csv(DATA_PATHS[\"daigt_v2\"])\n",
    "    df[\"text\"] = clean_text_series(df[\"text\"])\n",
    "    df = df.drop_duplicates(subset=[\"text\"]).reset_index(drop=True)\n",
    "\n",
    "    # 原 notebook: label = 1 if x==0 else 0\n",
    "    df[\"label\"] = df[\"label\"].apply(lambda x: 1 if x == 0 else 0)\n",
    "    return df[[\"text\", \"label\"]].drop_duplicates().reset_index(drop=True)\n",
    "\n",
    "def load_palm():\n",
    "    df = pd.read_csv(DATA_PATHS[\"palm\"])[[\"text\"]].copy()\n",
    "    df[\"text\"] = clean_text_series(df[\"text\"])\n",
    "    # 你原 notebook 这里标成 0，但从名字看它更像 AI 文本\n",
    "    # 为避免语义错误，这里建议改成 1 = AI\n",
    "    df[\"label\"] = 1\n",
    "    return df.drop_duplicates().reset_index(drop=True)\n",
    "\n",
    "def load_mistral():\n",
    "    df = pd.read_csv(DATA_PATHS[\"mistral\"])[[\"text\"]].copy()\n",
    "    df[\"text\"] = clean_text_series(df[\"text\"])\n",
    "    df[\"label\"] = 1\n",
    "    return df.drop_duplicates().reset_index(drop=True)\n",
    "\n",
    "def load_llama_falcon():\n",
    "    df = pd.read_csv(DATA_PATHS[\"llama_falcon\"])[[\"text\"]].copy()\n",
    "    df[\"text\"] = clean_text_series(df[\"text\"])\n",
    "    df[\"label\"] = 1\n",
