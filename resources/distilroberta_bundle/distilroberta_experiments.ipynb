    "    plt.figure(figsize=(8, 5))\n",
    "    if \"loss\" in df.columns:\n",
    "        d1 = df.dropna(subset=[\"loss\"])\n",
    "        if len(d1) > 0:\n",
    "            plt.plot(d1[\"step\"], d1[\"loss\"], label=\"train_loss\")\n",
    "    if \"eval_loss\" in df.columns:\n",
    "        d2 = df.dropna(subset=[\"eval_loss\"])\n",
