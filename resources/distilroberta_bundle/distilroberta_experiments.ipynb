    "# =========================\n",
    "# 1. 基础配置\n",
    "# =========================\n",
    "MODEL_CHECKPOINT = \"/kaggle/input/distilroberta-base/distilroberta-base\"\n",
    "\n",
    "DATA_PATHS = {\n",
    "    \"daigt_external\": \"/kaggle/input/daigt-external-dataset/daigt_external_dataset.csv\",\n",
    "    \"llm7prompt\": \"/kaggle/input/llm-7-prompt-training-dataset/train_essays_RDizzl3_seven_v1.csv\",\n",
    "    \"feedback_2021\": \"/kaggle/input/feedback21-and-fb-effectiveness/feedback-prize-2021.csv\",\n",
    "    \"feedback_effectiveness\": \"/kaggle/input/feedback21-and-fb-effectiveness/feedback-prize-effectiveness.csv\",\n",
    "    \"h2o\": \"/kaggle/input/h2oai-predict-the-llm/train.csv\",\n",
    "    \"daigt_v2\": \"/kaggle/input/daigt-v2-train-dataset/train_v2_drcat_02.csv\",\n",
    "    \"palm\": \"/kaggle/input/llm-generated-essay-using-palm-from-google-gen-ai/LLM_generated_essay_PaLM.csv\",\n",
    "    \"mistral\": \"/kaggle/input/llm-mistral-7b-instruct-texts/Mistral7B_CME_v7_15_percent_corruption.csv\",\n",
    "    \"llama_falcon\": \"/kaggle/input/daigt-data-llama-70b-and-falcon180b/llama_falcon_v3.csv\",\n",
    "    \"claude\": \"/kaggle/input/hello-claude-1000-essays-from-anthropic/persuade15_claude_instant1.csv\",\n",
    "}\n",
    "\n",
    "OUTPUT_DIR = Path(\"./distilroberta_experiments\")\n",
    "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# =========================\n",
    "# 2. 一次性运行的实验组\n",
    "# compare      -> 表5-7 主对比\n",
    "# hparam       -> 表5-8 超参数实验\n",
