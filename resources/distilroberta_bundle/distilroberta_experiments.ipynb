    "def dataset_feature_stats(name, df):\n",
    "    text_len = df[\"text\"].astype(str).str.len()\n",
    "    word_cnt = df[\"text\"].astype(str).str.split().apply(len)\n",
    "    return {\n",
    "        \"数据集\": name,\n",
    "        \"样本数\": len(df),\n",
    "        \"平均长度\": round(text_len.mean(), 2),\n",
    "        \"最大长度\": int(text_len.max()),\n",
    "        \"最小长度\": int(text_len.min()),\n",
    "        \"平均词数\": round(word_cnt.mean(), 2),\n",
    "    }\n",
    "\n",
    "table513 = pd.DataFrame([\n",
    "    dataset_feature_stats(\"官方训练集\", official_data),\n",
    "    dataset_feature_stats(\"外部数据集A\", external_A),\n",
    "    dataset_feature_stats(\"外部数据集B\", external_B),\n",
    "    dataset_feature_stats(\"全量融合数据\", full_data),\n",
    "])\n",
    "\n",
    "table513.to_csv(OUTPUT_DIR / \"table_5_13_dataset_feature_stats.csv\", index=False)\n",
    "display(table513)"
