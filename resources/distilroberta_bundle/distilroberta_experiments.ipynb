   "source": [
    "import os\n",
    "os.environ[\"TOKENIZERS_PARALLELISM\"] = \"false\"\n",
    "os.environ[\"TQDM_DISABLE\"] = \"1\"\n",
    "\n",
    "import pandas as pd\n",
    "import torch\n",
    "from tqdm import tqdm\n",
    "import transformers\n",
    "\n",
    "# 强制禁用 notebook widget 进度条，避免 HBoxModel / ipywidgets 版本冲突\n",
    "transformers.utils.logging.disable_progress_bar()\n",
    "\n",
    "compare_results = []\n",
    "\n",
    "if RUN_GROUPS[\"compare\"]:\n",
    "    compare_variants = [\n",
    "        {\n",
    "            \"name\": \"distilroberta_official_only\",\n",
    "            \"dataset\": build_dataset_variant(\n",
    "                name=\"official_only\",\n",
    "                use_official=True,\n",
    "                use_external_A=False,\n",
    "                use_external_B=False,\n",
    "                dedup=True,\n",
    "                balance=False\n",
    "            ),\n",
    "            \"max_length\": 128,\n",
    "            \"learning_rate\": 2e-5,\n",
    "            \"batch_size\": 2,\n",
    "            \"epochs\": EPOCHS_DEFAULT\n",
    "        },\n",
    "        {\n",
    "            \"name\": \"distilroberta_official_externalA\",\n",
    "            \"dataset\": build_dataset_variant(\n",
    "                name=\"official_externalA\",\n",
    "                use_official=True,\n",
    "                use_external_A=True,\n",
    "                use_external_B=False,\n",
    "                dedup=True,\n",
    "                balance=False\n",
    "            ),\n",
    "            \"max_length\": 128,\n",
    "            \"learning_rate\": 2e-5,\n",
    "            \"batch_size\": 2,\n",
    "            \"epochs\": EPOCHS_DEFAULT\n",
    "        },\n",
    "        {\n",
    "            \"name\": \"distilroberta_official_externalAB\",\n",
    "            \"dataset\": build_dataset_variant(\n",
    "                name=\"official_externalAB\",\n",
    "                use_official=True,\n",
    "                use_external_A=True,\n",
    "                use_external_B=True,\n",
    "                dedup=True,\n",
    "                balance=False\n",
    "            ),\n",
    "            \"max_length\": 128,\n",
    "            \"learning_rate\": 2e-5,\n",
    "            \"batch_size\": 2,\n",
    "            \"epochs\": EPOCHS_DEFAULT\n",
    "        },\n",
    "    ]\n",
    "\n",
    "    for cfg in compare_variants:\n",
    "        print(\"=\" * 80)\n",
    "        print(\"RUN:\", cfg[\"name\"])\n",
    "\n",
    "        res, labels, probs, preds, hist = train_one_experiment(\n",
    "            exp_name=cfg[\"name\"],\n",
    "            train_df=cfg[\"dataset\"][\"train_df\"],\n",
    "            valid_df=cfg[\"dataset\"][\"valid_df\"],\n",
    "            max_length=cfg[\"max_length\"],\n",
    "            learning_rate=cfg[\"learning_rate\"],\n",
    "            batch_size=cfg[\"batch_size\"],\n",
    "            num_epochs=cfg[\"epochs\"],\n",
    "            fp16=torch.cuda.is_available()\n",
    "        )\n",
    "\n",
    "        compare_results.append({\n",
    "            \"model\": \"DistilRoBERTa\",\n",
    "            \"train_data\": cfg[\"dataset\"][\"name\"],\n",
    "            \"max_length\": cfg[\"max_length\"],\n",
    "            \"accuracy\": res[\"accuracy\"],\n",
    "            \"precision\": res[\"precision\"],\n",
    "            \"recall\": res[\"recall\"],\n",
    "            \"f1\": res[\"f1\"],\n",
    "            \"roc_auc\": res[\"roc_auc\"]\n",
    "        })\n",
    "\n",
    "    table57 = pd.DataFrame(compare_results)\n",
    "    save_path = OUTPUT_DIR / \"table_5_7_distilroberta_compare.csv\"\n",
    "    table57.to_csv(save_path, index=False)\n",
    "\n",
    "    print(\"\\nSaved to:\", save_path)\n",
    "    print(\"\\nTable 5.7 Results:\")\n",
    "    print(table57.to_string(index=False))"
