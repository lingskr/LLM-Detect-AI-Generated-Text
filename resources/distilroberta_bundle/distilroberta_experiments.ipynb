    "hparam_results = []\n",
    "\n",
    "if RUN_GROUPS[\"hparam\"]:\n",
    "    base_dataset = build_dataset_variant(\n",
    "        name=\"official_externalAB_for_hparam\",\n",
    "        use_official=True,\n",
    "        use_external_A=True,\n",
    "        use_external_B=True,\n",
    "        dedup=True,\n",
    "        balance=False\n",
    "    )\n",
    "\n",
    "    hparam_grid = [\n",
    "        {\"exp_id\": \"E1\", \"lr\": 2e-5, \"batch\": 16 if QUICK_MODE else 8, \"grad_accum\": 1 if QUICK_MODE else 2, \"epochs\": 3, \"max_length\": 128},\n",
    "        {\"exp_id\": \"E2\", \"lr\": 2e-5, \"batch\": 16 if QUICK_MODE else 8, \"grad_accum\": 1 if QUICK_MODE else 2, \"epochs\": 5 if not QUICK_MODE else 3, \"max_length\": 128},\n",
    "        {\"exp_id\": \"E3\", \"lr\": 3e-5, \"batch\": 8 if QUICK_MODE else 4, \"grad_accum\": 1 if QUICK_MODE else 4, \"epochs\": 3, \"max_length\": 256},\n",
    "        {\"exp_id\": \"E4\", \"lr\": 5e-5, \"batch\": 8 if QUICK_MODE else 4, \"grad_accum\": 1 if QUICK_MODE else 4, \"epochs\": 3, \"max_length\": 256},\n",
    "    ]\n",
    "\n",
    "    for cfg in hparam_grid:\n",
    "        exp_name = f\"distilroberta_hparam_{cfg['exp_id']}\"\n",
    "        print(\"=\" * 80)\n",
    "        print(\"RUN:\", exp_name)\n",
    "\n",
    "        res, labels, probs, preds, hist = train_one_experiment(\n",
    "            exp_name=exp_name,\n",
    "            train_df=base_dataset[\"train_df\"],\n",
    "            valid_df=base_dataset[\"valid_df\"],\n",
    "            max_length=cfg[\"max_length\"],\n",
    "            learning_rate=cfg[\"lr\"],\n",
    "            batch_size=cfg[\"batch\"],\n",
    "            grad_accum=cfg[\"grad_accum\"],\n",
    "            num_epochs=cfg[\"epochs\"],\n",
    "            fp16=torch.cuda.is_available()\n",
    "        )\n",
    "\n",
    "        hparam_results.append({\n",
    "            \"实验编号\": cfg[\"exp_id\"],\n",
    "            \"learning_rate\": cfg[\"lr\"],\n",
    "            \"batch_size\": cfg[\"batch\"],\n",
    "            \"epoch\": cfg[\"epochs\"],\n",
    "            \"max_length\": cfg[\"max_length\"],\n",
    "            \"early_stopping\": \"是\",\n",
    "            \"ROC-AUC\": res[\"roc_auc\"],\n",
    "            \"Accuracy\": res[\"accuracy\"],\n",
    "            \"Precision\": res[\"precision\"],\n",
    "            \"Recall\": res[\"recall\"],\n",
    "            \"F1-score\": res[\"f1\"],\n",
    "        })\n",
    "\n",
    "    table58 = pd.DataFrame(hparam_results)\n",
    "    table58.to_csv(OUTPUT_DIR / \"table_5_8_distilroberta_hparams.csv\", index=False)\n",
    "    display(table58)"
   ]
  },
